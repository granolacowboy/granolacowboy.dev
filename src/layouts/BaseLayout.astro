---
// Self-hosted variable fonts (fontsource), then tokens, then global styles.
import '@fontsource-variable/space-grotesk/index.css';
import '@fontsource-variable/source-serif-4/index.css';
import '@fontsource-variable/jetbrains-mono/index.css';
// Hashed URLs for the three latin variable woff2 files (the subsets every
// page uses), preloaded in <head> below; the other subsets still load on
// demand through each @font-face unicode-range.
import spaceGroteskWoff2 from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import sourceSerifWoff2 from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import jetbrainsMonoWoff2 from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/global.css';
import {
  GITHUB_URL,
  HANDLE,
  SITE_DESCRIPTION,
  SITE_TITLE,
  SITE_URL,
  CANONICAL_ORG_ID,
  CANONICAL_PERSON_ID,
  PERSON_CANONICAL_NAME,
  PERSON_ALT_NAME,
  PROFILE_SAME_AS,
} from '../site.config';

interface Props {
  /** Page title, rendered as "{title} | {site title}". Omit on the home page. */
  title?: string;
  /** Meta description; falls back to the site default. */
  description?: string;
  /** OpenGraph object type; post/case-study detail pages pass 'article'. */
  ogType?: 'website' | 'article';
  /** Prevent utility/error pages from appearing in search results. */
  noindex?: boolean;
  /** Allow data-heavy pages to use a wider content column. */
  wide?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  ogType = 'website',
  noindex = false,
  wide = false,
} = Astro.props;
const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;

// Canonical URL, official pattern from docs.astro.build/en/reference/api-reference/
// ("Construct a canonical URL using your production domain"). Prerendered routes
// get site-based URLs at build time because `site` is set in astro.config.mjs.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Site-wide OG image: one static branded 1200×630 image at public/og.png.
const ogImageURL = new URL('/og.png', Astro.site);
const ogImageAlt = `${SITE_TITLE} wordmark on a dark background`;

const navItems = [
  { href: '/writing/', label: 'Writing' },
  { href: '/projects/', label: 'Projects' },
  { href: '/about/', label: 'About' },
];
const { pathname } = Astro.url;
const isCurrent = (href: string) =>
  pathname === href || pathname === href.slice(0, -1) || pathname.startsWith(href);

// Portfolio identity spine: the canonical Person (defined authoritatively on the
// apex, mhsbsolutions.com, and reused here by @id) plus this site's own WebSite.
const identityGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': CANONICAL_PERSON_ID,
      name: PERSON_CANONICAL_NAME,
      alternateName: PERSON_ALT_NAME,
      url: `${SITE_URL}/`,
      worksFor: { '@id': CANONICAL_ORG_ID },
      sameAs: PROFILE_SAME_AS,
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      name: SITE_TITLE,
      url: `${SITE_URL}/`,
      description: SITE_DESCRIPTION,
      author: { '@id': CANONICAL_PERSON_ID },
      inLanguage: 'en-US',
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {/* Font fetches are CORS-mode even same-origin, so the preloads
        need `crossorigin` or the browser refetches the files. */}
    <link rel="preload" as="font" type="font/woff2" href={spaceGroteskWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={sourceSerifWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={jetbrainsMonoWoff2} crossorigin />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={new URL('rss.xml', Astro.site)}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(identityGraph)} />
    {/* Dark is the only theme (design-system spec), so the former
        theme-toggle script is gone and the site ships zero JavaScript
        from this layout. */}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="container">
        <a class="wordmark" href="/">{HANDLE}<span class="wordmark-accent">.dev</span></a>
        <nav class="site-nav" aria-label="Main">
          <ul>
            {
              navItems.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>
    <main id="main-content" class:list={['container', { 'container-wide': wide }]} tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        {/* Uppercase presentation comes from CSS text-transform; markup
            keeps the handle in its exact lowercase form. */}
        <p>© {new Date().getFullYear()} · {HANDLE}.dev</p>
        <p><a href={GITHUB_URL}>GitHub</a></p>
      </div>
    </footer>
  </body>
</html>
