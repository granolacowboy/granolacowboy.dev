---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RiverList from '../../components/RiverList.astro';
import { getRiver } from '../../lib/river';

const items = (await getRiver()).filter((i) => i.type === 'note');
---

<BaseLayout title="Notes" description="Short notes and observations by Rich Berman.">
  <header class="page-header">
    <h1>Notes</h1>
  </header>
  <RiverList items={items} empty="No notes yet." heading="h2" />
</BaseLayout>
