---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTagCounts } from '../../lib/river';

const tags = await getTagCounts();
---

<BaseLayout title="Tags" description="Browse Rich Berman's writing and notes by tag.">
  <header class="page-header">
    <h1>Tags</h1>
  </header>
  {tags.length === 0 && <p class="lede">No tags yet.</p>}
  {
    tags.length > 0 && (
      <ul class="tag-cloud">
        {tags.map(({ tag, count }) => (
          <li>
            <a class="tag" href={`/tags/${tag}/`}>{tag}</a> <span class="count">{count}</span>
          </li>
        ))}
      </ul>
    )
  }
  <p class="metadata"><a href="/archive/">Archive by year</a></p>
</BaseLayout>
