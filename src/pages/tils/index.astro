---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RiverList from '../../components/RiverList.astro';
import { getRiver } from '../../lib/river';

const items = (await getRiver()).filter((i) => i.type === 'til');
---

<BaseLayout title="TILs" description="Today I Learned: short technical notes by Rich Berman.">
  <header class="page-header">
    <p class="eyebrow">INDEX · TIL</p>
    <h1>Today I Learned</h1>
  </header>
  <RiverList items={items} empty="No TILs yet." heading="h2" />
</BaseLayout>
