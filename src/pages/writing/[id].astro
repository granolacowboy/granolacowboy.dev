---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, AI_DISCLOSURE } from '../../lib/river';

export async function getStaticPaths() {
  // Draft posts get no routes (PLAN Phase 2). Slug semantics: post.id.
  // Newest first, matching the writing index, so every post carries a
  // stable "NN / NN" position readout.
  const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: { post, position: i + 1, total: posts.length },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
  position: number;
  total: number;
}

const { post, position, total } = Astro.props;
const { Content } = await render(post);
const pad = (value: number) => String(value).padStart(2, '0');

// Reading time is derived from the actual body (words / 220 wpm) and renders
// alongside the position index and the post date.
const words = (post.body ?? '').match(/[\p{L}\p{N}][\p{L}\p{N}'-]*/gu)?.length ?? 0;
const minutes = Math.max(1, Math.round(words / 220));
---

<BaseLayout title={post.data.title} description={post.data.description} ogType="article">
  <article class="prose">
    <header class="page-header">
      <p class="eyebrow">WRITING · {pad(position)} / {pad(total)}</p>
      <h1>{post.data.title}</h1>
      <p class="metadata">
        {pad(position)} / {pad(total)} · {minutes} MIN
        {' · '}
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        {post.data.tags.length > 0 && (
          <>
            {' · '}
            {post.data.tags.map((tag, j) => (
              <>
                {j > 0 && ' '}
                <a class="tag" href={`/tags/${tag}/`}>{tag}</a>
              </>
            ))}
          </>
        )}
      </p>
    </header>
    <Content />
    {post.data.provenance === 'human-ai-edited' && <p class="metadata">{AI_DISCLOSURE}</p>}
    <div class="divider--labeled">END · {pad(position)}</div>
  </article>
</BaseLayout>
