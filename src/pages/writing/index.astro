---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../lib/river';

// Drafts excluded. pubDate orders the list and renders as a UTC date; rows also
// carry a mono position readout.
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const pad = (value: number) => String(value).padStart(2, '0');
---

<BaseLayout title="Writing" description="Writing and notes by Rich Berman.">
  <header class="page-header">
    <p class="eyebrow">INDEX · WRITING</p>
    <h1>Writing</h1>
  </header>
  {
    posts.length > 0 && (
      <ol class="writing-index">
        {posts.map((post, i) => (
          <li class="writing-row">
            <p class="writing-row-title">
              <a href={`/writing/${post.id}/`}>{post.data.title}</a>
            </p>
            <p class="metadata">
              {pad(i + 1)} / {pad(posts.length)} · WRITING
              {' · '}
              <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
              {post.data.tags.length > 0 && (
                <>
                  {' · '}
                  {post.data.tags.map((tag, j) => (
                    <>
                      {j > 0 && ' '}
                      <a class="tag" href={`/tags/${tag}/`}>{tag}</a>
                    </>
                  ))}
                </>
              )}
            </p>
            <p class="writing-row-desc">{post.data.description}</p>
          </li>
        ))}
      </ol>
    )
  }
  {posts.length === 0 && <p class="lede">No long-form writing yet.</p>}
  <p class="metadata">
    <a href="/tags/">Tags</a>
    {' · '}<a href="/archive/">Archive</a>
    {' · '}<a href="/rss.xml">RSS</a>
  </p>
</BaseLayout>
