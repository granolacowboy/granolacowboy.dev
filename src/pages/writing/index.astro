---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SHOW_DATES } from '../../site.config';

// Drafts excluded. pubDate orders the list; it renders only if
// SHOW_DATES is ever flipped to true (PLAN Open Item #3: dates stay
// hidden), so rows carry a mono position readout instead.
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const pad = (value: number) => String(value).padStart(2, '0');
---

<BaseLayout title="Writing" description="Essays on legal technology, forward-deployed engineering, and building for regulated buyers.">
  <header class="page-header">
    <p class="eyebrow">INDEX · WRITING</p>
    <h1>Writing</h1>
  </header>
  {
    posts.length > 0 && (
      <ol class="writing-index">
        {posts.map((post, i) => (
          <li class="writing-row">
            <p class="writing-row-title">
              <a href={`/writing/${post.id}/`}>{post.data.title}</a>
            </p>
            <p class="metadata">
              {pad(i + 1)} / {pad(posts.length)} · FIELD NOTES
              {SHOW_DATES && (
                <>
                  {' · '}
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString('en-US', { dateStyle: 'medium' })}
                  </time>
                </>
              )}
            </p>
            <p class="writing-row-desc">{post.data.description}</p>
          </li>
        ))}
      </ol>
    )
  }
</BaseLayout>
