---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SHOW_DATES } from '../../site.config';

// Drafts excluded. pubDate orders the list; it is only displayed if SHOW_DATES
// is ever flipped to true (PLAN Open Item #3: dates stay hidden).
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout title="Writing" description="Essays on legal technology, forward-deployed engineering, and building for regulated buyers.">
  <h1>Writing</h1>
  {
    posts.length > 0 && (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <h2 class="post-title">
              <a href={`/writing/${post.id}/`}>{post.data.title}</a>
            </h2>
            {SHOW_DATES && (
              <p>
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('en-US', { dateStyle: 'medium' })}
                </time>
              </p>
            )}
            <p>{post.data.description}</p>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
