---
import BaseLayout from '../layouts/BaseLayout.astro';
import RiverList from '../components/RiverList.astro';
import { getRiver } from '../lib/river';
import { ARTIFACT_NAME, ARTIFACT_REPO_URL, ARTIFACT_WRITEUP_PATH } from '../site.config';

// The river: the merged, reverse-chronological stream across every entry type.
const recent = (await getRiver()).slice(0, 20);
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-heading">
    {/* Positioning stub (2026-09-27): a factual hero for the personal weblog.
        Rich to replace the headline and lede with his own voice. Do not ghost-write it. */}
    <h1 id="hero-heading" class="display-xl">Richard Berman</h1>
    <p class="lede">
      My personal site: the things I build, and notes on building them. I work mostly with law firms
      through MHSB Solutions.
    </p>
  </section>

  <section class="home-section" aria-labelledby="river-heading">
    <h2 id="river-heading">Recent</h2>
    <RiverList
      items={recent}
      empty="Nothing posted yet. Writing, links, and notes will appear here."
    />
    <p class="metadata">
      <a href="/writing/">All writing</a>
      {' · '}<a href="/tags/">Tags</a>
      {' · '}<a href="/rss.xml">RSS</a>
    </p>
  </section>

  <section class="home-section" aria-labelledby="work-heading">
    <h2 id="work-heading">Projects</h2>

    <article class="card">
      <h3>{ARTIFACT_NAME}</h3>
      <p>A reference implementation of secure legal intake automation on the Model Context Protocol. The server is fully deterministic (no LLM calls, no network calls) and handles conflict screening, matter validation, follow-up templating, and triage logging. The language model does the language work, the server does the record work, with a clean boundary between them.</p>
      <ul class="tag-row" aria-label="Tags">
        <li class="tag">mcp</li>
        <li class="tag">legal-ops</li>
        <li class="tag">deterministic</li>
      </ul>
      <p>
        <a href={ARTIFACT_REPO_URL}>Repository</a>
        {ARTIFACT_WRITEUP_PATH && <> · <a href={ARTIFACT_WRITEUP_PATH}>Write-up</a></>}
        {' · '}<a href="/projects/intake-safety/">System proof</a>
      </p>
    </article>

    <article class="card">
      <h3>Deterministic legal intake safety proof</h3>
      <p>A reproducible walk-through showing why a correct final answer is not enough: conflicts provenance, write refusal, adversarial inputs, trace assertions, and release evidence all sit outside the model.</p>
      <ul class="tag-row" aria-label="Tags">
        <li class="tag">evals</li>
        <li class="tag">safety</li>
        <li class="tag">provenance</li>
      </ul>
      <p><a href="/projects/intake-safety/">Explore the system proof</a></p>
    </article>

    <article class="card">
      <h3>Session Benchmark v0</h3>
      <p>A public, client-scrubbed research artifact built from aggregate patterns across 1,299 agent sessions. It tests whether an agent can preserve constraints, privacy boundaries, evidence, and executable next steps when the source context is messy.</p>
      <ul class="tag-row" aria-label="Tags">
        <li class="tag">benchmark</li>
        <li class="tag">agents</li>
        <li class="tag">client-scrubbed</li>
      </ul>
      <p><a href="/projects/session-benchmark/">Explore the benchmark</a></p>
    </article>
  </section>
</BaseLayout>
