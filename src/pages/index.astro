---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NdaNote from '../components/NdaNote.astro';
import { ARTIFACT_NAME, ARTIFACT_REPO_URL } from '../site.config';

// Drafts never render: excluded here and in every getStaticPaths (PLAN Phase 2).
// Sections below render only when they have entries; empty sections are simply absent.
const caseStudies = (await getCollection('caseStudies', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

// pubDate orders the list only; dates are never displayed (SHOW_DATES in site.config).
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout>
  <section class="hero">
    <h1>Granola Cowboy</h1>
    <p class="lede">I run MHSB, where I help law firms get their automation right. This site is where I write about what I am learning along the way.</p>
    <a class="cta" href="/about/">More about me</a>
  </section>

  {
    caseStudies.length > 0 && (
      <section class="home-section" aria-labelledby="work-heading">
        <h2 id="work-heading">Selected work</h2>
        <ul class="card-list">
          {caseStudies.map((study) => (
            <li class="card">
              <p class="eyebrow">{study.data.client}</p>
              <h3>
                <a href={`/work/${study.id}/`}>{study.data.title}</a>
              </h3>
              <p>{study.data.summary}</p>
            </li>
          ))}
        </ul>
        <NdaNote />
      </section>
    )
  }

  {
    posts.length > 0 && (
      <section class="home-section" aria-labelledby="writing-heading">
        <h2 id="writing-heading">Writing</h2>
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <h3 class="post-title">
                <a href={`/writing/${post.id}/`}>{post.data.title}</a>
              </h3>
              <p>{post.data.description}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="home-section" aria-labelledby="featured-project-heading">
    <h2 id="featured-project-heading">Featured project</h2>
    <div class="card">
      <h3>{ARTIFACT_NAME}</h3>
      <p>An open-source MCP server for legal intake triage. Deterministic conflict checks, matter validation, and follow-up templating, with no LLM calls inside the server. I built it to show what a secure, auditable intake pipeline looks like in practice.</p>
      <p>
        <a href={ARTIFACT_REPO_URL}>Repository</a> · <a href="/projects/">About this project</a>
      </p>
    </div>
  </section>
</BaseLayout>
