---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { ARTIFACT_NAME, ARTIFACT_REPO_URL, ARTIFACT_WRITEUP_PATH, SHOW_DATES } from '../site.config';

// Newest first; drafts excluded. pubDate orders the list but never
// renders (SHOW_DATES stays false); rows carry a mono position
// readout instead.
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const pad = (value: number) => String(value).padStart(2, '0');
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-heading">
    <p class="eyebrow">FIELD RECORD · 2016–2026 <span class="accent">[FDE / APPLIED AI]</span></p>
    <h1 id="hero-heading" class="display-xl">
      Ten years <span class="accent">forward-deployed</span> in the legal vertical.
    </h1>
    <p class="lede">
      I build and ship automation inside law firms: intake, conflicts, drafting pipelines. I
      bring a security researcher's habits to AI adoption. The client work here is anonymized;
      the patterns are real.
    </p>
    <div class="sweep-cue" aria-hidden="true">
      <span class="label">SCROLL · 01 / 03</span>
      <span class="sweep-line"></span>
    </div>
  </section>

  <section class="home-section" aria-labelledby="featured-heading">
    <article class="card">
      <p class="eyebrow">PROJECT · 01 / 02 <span class="accent">[OPEN SOURCE]</span></p>
      <h2 id="featured-heading">{ARTIFACT_NAME}</h2>
      <p>I built this as a reference implementation of what secure legal intake automation can look like using the Model Context Protocol. The server is fully deterministic (no LLM calls, no network calls) and handles conflict screening, matter validation, follow-up templating, and triage logging. The idea is that the language model does the language work, and the server does the record work, with a clean boundary between them.</p>
      <ul class="tag-row" aria-label="Tags">
        <li class="tag">mcp</li>
        <li class="tag">legal-ops</li>
        <li class="tag">deterministic</li>
      </ul>
      <p>
        <a href={ARTIFACT_REPO_URL}>Repository</a>
        {ARTIFACT_WRITEUP_PATH && <> · <a href={ARTIFACT_WRITEUP_PATH}>Write-up</a></>}
      </p>
    </article>
  </section>

  <section class="home-section" aria-labelledby="writing-heading">
    <p class="eyebrow">INDEX · WRITING</p>
    <h2 id="writing-heading" class="display-l">Writing</h2>
    <ol class="writing-index">
      {
        posts.map((post, i) => (
          <li class="writing-row">
            <p class="writing-row-title">
              <a href={`/writing/${post.id}/`}>{post.data.title}</a>
            </p>
            <p class="metadata">
              {pad(i + 1)} / {pad(posts.length)} · FIELD NOTES
              {SHOW_DATES && (
                <>
                  {' · '}
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString('en-US', { dateStyle: 'medium' })}
                  </time>
                </>
              )}
            </p>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>
