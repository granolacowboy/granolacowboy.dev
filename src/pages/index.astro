---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { ARTIFACT_NAME, ARTIFACT_REPO_URL, ARTIFACT_WRITEUP_PATH, SHOW_DATES } from '../site.config';

// Newest first; drafts excluded. pubDate orders the list but never
// renders (SHOW_DATES stays false); rows carry a mono position readout.
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const pad = (value: number) => String(value).padStart(2, '0');
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-heading">
    <p class="eyebrow">RICH BERMAN · GRANOLACOWBOY</p>
    <h1 id="hero-heading" class="display-xl">I build systems and take them apart.</h1>
    <p class="lede">
      Systems, security, automation, legal technology, old software, and failure modes.
    </p>
  </section>

  <section class="home-section" aria-labelledby="work-heading">
    <p class="eyebrow">INDEX · PROJECTS</p>
    <h2 id="work-heading" class="display-l">Projects</h2>

    <article class="card">
      <p class="eyebrow">PROJECT · 01 / 03 <span class="accent">[OPEN SOURCE]</span></p>
      <h3>{ARTIFACT_NAME}</h3>
      <p>A reference implementation of secure legal intake automation on the Model Context Protocol. The server is fully deterministic (no LLM calls, no network calls) and handles conflict screening, matter validation, follow-up templating, and triage logging. The language model does the language work, the server does the record work, with a clean boundary between them.</p>
      <ul class="tag-row" aria-label="Tags">
        <li class="tag">mcp</li>
        <li class="tag">legal-ops</li>
        <li class="tag">deterministic</li>
      </ul>
      <p>
        <a href={ARTIFACT_REPO_URL}>Repository</a>
        {ARTIFACT_WRITEUP_PATH && <> · <a href={ARTIFACT_WRITEUP_PATH}>Write-up</a></>}
        {' · '}<a href="/projects/intake-safety/">System proof</a>
      </p>
    </article>

    <article class="card">
      <p class="eyebrow">PROJECT · 02 / 03 <span class="accent">[SYSTEM PROOF]</span></p>
      <h3>Deterministic legal intake safety proof</h3>
      <p>A reproducible walk-through showing why a correct final answer is not enough: conflicts provenance, write refusal, adversarial inputs, trace assertions, and release evidence all sit outside the model.</p>
      <ul class="tag-row" aria-label="Tags">
        <li class="tag">evals</li>
        <li class="tag">safety</li>
        <li class="tag">provenance</li>
      </ul>
      <p><a href="/projects/intake-safety/">Explore the system proof</a></p>
    </article>

    <article class="card">
      <p class="eyebrow">PROJECT · 03 / 03 <span class="accent">[RESEARCH]</span></p>
      <h3>Session Benchmark v0</h3>
      <p>A public, client-scrubbed research artifact built from aggregate patterns across 1,299 agent sessions. It tests whether an agent can preserve constraints, privacy boundaries, evidence, and executable next steps when the source context is messy.</p>
      <ul class="tag-row" aria-label="Tags">
        <li class="tag">benchmark</li>
        <li class="tag">agents</li>
        <li class="tag">client-scrubbed</li>
      </ul>
      <p><a href="/projects/session-benchmark/">Explore the benchmark</a></p>
    </article>
  </section>

  <section class="home-section" aria-labelledby="writing-heading">
    <p class="eyebrow">INDEX · WRITING</p>
    <h2 id="writing-heading" class="display-l">Writing</h2>
    <ol class="writing-index">
      {
        posts.map((post, i) => (
          <li class="writing-row">
            <p class="writing-row-title">
              <a href={`/writing/${post.id}/`}>{post.data.title}</a>
            </p>
            <p class="metadata">
              {pad(i + 1)} / {pad(posts.length)} · WRITING
              {SHOW_DATES && (
                <>
                  {' · '}
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString('en-US', { dateStyle: 'medium' })}
                  </time>
                </>
              )}
            </p>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>
