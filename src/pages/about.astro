---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  EMAIL,
  EMAIL_URL,
  GITHUB_URL,
  HANDLE,
  LINKEDIN_URL,
  PERSON_NAME,
} from '../site.config';
---

<BaseLayout title="About" description={`About ${PERSON_NAME} | ${HANDLE}.`}>
  <article>
    <header class="page-header">
      <p class="eyebrow">RICH BERMAN · MHSB SOLUTIONS</p>
      <h1>About</h1>
    </header>
    <div class="prose">
      <p>I am Rich Berman (granolacowboy). Through <a href="https://www.mhsbsolutions.com/">MHSB Solutions</a>, I build systems for law firms: intake, CRM, reporting, document workflows, integration, automation, and applied AI.</p>
      <p>The work spans both the operating environment and the underlying technology. This site documents what I can share publicly; client details are omitted.</p>
    </div>

    <h2 id="contact">Contact</h2>
    <ul class="contact-list">
      <li>
        <span class="label">Email</span>
        <a class="data" href={EMAIL_URL}>{EMAIL}</a>
      </li>
      <li>
        <span class="label">GitHub</span>
        <a class="data" href={GITHUB_URL}>github.com/{HANDLE}</a>
      </li>
      <li>
        <span class="label">LinkedIn</span>
        <a class="data" href={LINKEDIN_URL}>linkedin.com/in/mhsb</a>
      </li>
      <li>
        <span class="label">Company</span>
        <a class="data" href="https://www.mhsbsolutions.com/">mhsbsolutions.com</a>
      </li>
    </ul>
  </article>
</BaseLayout>
