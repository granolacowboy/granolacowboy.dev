---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  EMAIL,
  EMAIL_URL,
  GITHUB_URL,
  GITLAB_URL,
  HANDLE,
  HUGGINGFACE_URL,
  KAGGLE_URL,
  LINKEDIN_URL,
  PERSON_NAME,
} from '../site.config';
---

<BaseLayout title="About" description={`About ${PERSON_NAME} | ${HANDLE}.`}>
  <article>
    <header class="page-header">
      <h1>About</h1>
    </header>
    <div class="prose">
      {/* Positioning stub (2026-09-27): honest, factual About for the personal weblog.
          Rich to replace this with his own bio in his own voice. Do not ghost-write it. */}
      <p>I am Richard Berman (granolacowboy). This is my personal site, where I keep my writing, projects, and notes.</p>
      <p>I build software, mostly for law firms, through <a href="https://www.mhsbsolutions.com/">MHSB Solutions</a>.</p>
    </div>

    <h2 id="contact">Contact</h2>
    <ul class="contact-list">
      <li>
        <span class="label">Email</span>
        <a class="data" href={EMAIL_URL}>{EMAIL}</a>
      </li>
      <li>
        <span class="label">GitHub</span>
        <a class="data" href={GITHUB_URL}>github.com/{HANDLE}</a>
      </li>
      <li>
        <span class="label">Hugging Face</span>
        <a class="data" href={HUGGINGFACE_URL}>huggingface.co/{HANDLE}</a>
      </li>
      <li>
        <span class="label">GitLab</span>
        <a class="data" href={GITLAB_URL}>gitlab.com/{HANDLE}</a>
      </li>
      <li>
        <span class="label">Kaggle</span>
        <a class="data" href={KAGGLE_URL}>kaggle.com/{HANDLE}</a>
      </li>
      <li>
        <span class="label">LinkedIn</span>
        <a class="data" href={LINKEDIN_URL}>linkedin.com/in/mhsb</a>
      </li>
      <li>
        <span class="label">Company</span>
        <a class="data" href="https://www.mhsbsolutions.com/">mhsbsolutions.com</a>
      </li>
    </ul>
  </article>
</BaseLayout>
