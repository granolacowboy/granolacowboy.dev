---
interface Props {
  current: 'overview' | 'cases' | 'failure-atlas' | 'registry';
}

const { current } = Astro.props;
const items = [
  { id: 'overview', href: '/projects/session-benchmark/', label: 'Overview' },
  { id: 'cases', href: '/projects/session-benchmark/cases/', label: 'Cases and results' },
  { id: 'failure-atlas', href: '/projects/session-benchmark/failure-atlas/', label: 'Failure atlas' },
  { id: 'registry', href: '/projects/session-benchmark/registry/', label: 'Synthetic registry' },
] as const;
---

<nav class="benchmark-nav" aria-label="Session Benchmark">
  <ul>
    {items.map((item) => (
      <li>
        <a href={item.href} aria-current={item.id === current ? 'page' : undefined}>{item.label}</a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .benchmark-nav {
    margin-block: 1.5rem 2.5rem;
    padding-block: 0.75rem;
    border-block: 1px solid var(--color-border);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    color: var(--color-muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--color-text);
  }

  /* Current page: accent color plus an underline, so state never reads
     by color alone (matches the site nav, WCAG 1.4.1). */
  a[aria-current='page'] {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
</style>
